---
import "../styles/vars.css";
import "../styles/content.css";
import "../styles/layout.css";

import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import { getSiteSettings, getUsedFontKeys } from "../lib/sanity";
import { BASE_FONTS_URL, FONTS, googleFontsUrl } from "../lib/fonts";
import { resolveSiteIdentity } from "../lib/siteConfig";

export interface Props {
    title?: string;
    description?: string;
    /** URL of the page's largest above-the-fold image (the LCP
        candidate). Tiles/cards use CSS background-image, which the
        browser only discovers after CSS parses — a preload hint with
        high priority starts the download during HTML parse instead. */
    preloadImage?: string | null;
    children?: any;
}

const { title, description, preloadImage } = Astro.props;

// Site identity (name, socials, contact) comes from the Sanity
// "Site settings" document, merged over neutral demo defaults —
// client-specific values never live in code.
const settings = await getSiteSettings();
const site = resolveSiteIdentity(settings);

// Font plan: vars.css ships the base fonts; anything else — the
// site-wide theme font and any fonts picked via the editor's Font
// menu — is loaded on demand, so visitors only download fonts that
// published content actually uses.
const themeFont =
    settings?.fontTheme && FONTS[settings.fontTheme] ? settings.fontTheme : "eb-garamond";
const usedFontKeys = await getUsedFontKeys();
const extraFontsUrl = googleFontsUrl([...new Set([themeFont, ...usedFontKeys])]);
const themeFontCss =
    themeFont !== "eb-garamond" ? `:root { --font-serif: ${FONTS[themeFont].stack}; }` : null;

// Browser-tab title: "SiteName - Page" on subpages, bare name at home.
const tabTitle = title && title !== site.siteName ? `${site.siteName} - ${title}` : site.siteName;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description || `${site.siteName} - ${site.tagline}`} />
        <meta name="generator" content={Astro.generator} />
        <title>{tabTitle}</title>
        {/* Monogram favicon in the site serif: SVG for modern
            browsers, .ico fallback, apple-touch-icon for iOS. */}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        {/* Fonts load async (media=print until loaded) so text paints
            immediately in the fallback serif and upgrades — a blocking
            fonts request cost ~1.85s of first paint (Aug 5 round). The
            preconnects start both Google handshakes during HTML parse. */}
        {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={BASE_FONTS_URL} media="print" onload="this.media='all'" />
        <noscript><link rel="stylesheet" href={BASE_FONTS_URL} /></noscript>
        {extraFontsUrl && <link rel="stylesheet" href={extraFontsUrl} media="print" onload="this.media='all'" />}
        {extraFontsUrl && <noscript><link rel="stylesheet" href={extraFontsUrl} /></noscript>}
        {themeFontCss && <style set:html={themeFontCss}></style>}
        <ClientRouter />
        <script is:inline>
            // Apply the visitor's stored theme BEFORE first paint, so a
            // dark-mode visitor never sees a white flash. Policy: light
            // unless the visitor explicitly chose dark via the toggle —
            // the OS preference is deliberately not consulted.
            (() => {
                let stored = null;
                if (typeof localStorage !== "undefined") {
                    stored = localStorage.getItem("theme");
                }
                if (stored === "dark") {
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.removeAttribute("data-theme");
                }
            })();
        </script>
    </head>
    <body class="site-wrapper">
        <Header site={site} />

        <main id="site-main" class="site-main">
            <div id="swup" class="transition-fade">
                <slot />
            </div>
        </main>

        {/* Deliberately OUTSIDE the #swup wrapper: .transition-fade
            keeps a transform after its entry animation, and any
            transformed ancestor becomes the containing block for
            position:fixed — inside it, the lightbox would size to the
            content column instead of the viewport. */}
        <Lightbox />

        <Footer site={site} />

        <script>
            // Chrome wiring. astro:page-load fires on first load AND
            // after every client-side navigation, so everything binds
            // against the freshly-swapped DOM each time.

            const syncThemeIcons = () => {
                const dark =
                    document.documentElement.getAttribute("data-theme") === "dark";
                const sun = document.querySelector<HTMLElement>(".sun-icon");
                const moon = document.querySelector<HTMLElement>(".moon-icon");
                if (!sun || !moon) return;
                sun.style.display = dark ? "inline-block" : "none";
                moon.style.display = dark ? "none" : "inline-block";
            };

            const wireMenuBurger = () => {
                const burger = document.querySelector(".nav-burger");
                const wrapper = document.querySelector(".site-wrapper");
                if (!burger || !wrapper) return;
                burger.addEventListener("click", (event) => {
                    event.preventDefault();
                    wrapper.classList.toggle("site-head-open");
                });
            };

            const wireThemeToggle = () => {
                syncThemeIcons();
                const toggle = document.getElementById("theme-toggle");
                if (!toggle) return;
                toggle.addEventListener("click", () => {
                    const goingDark =
                        document.documentElement.getAttribute("data-theme") !== "dark";
                    if (goingDark) {
                        document.documentElement.setAttribute("data-theme", "dark");
                    } else {
                        document.documentElement.removeAttribute("data-theme");
                    }
                    localStorage.setItem("theme", goingDark ? "dark" : "light");
                    syncThemeIcons();
                });
            };

            // Email links ship as split data attributes and are
            // assembled here in the browser, so Cloudflare's Email
            // Obfuscation never detects/rewrites them (its decoder
            // doesn't re-run after client-side navigation, which
            // used to leave broken cdn-cgi links).
            const assembleEmailLinks = () => {
                document
                    .querySelectorAll<HTMLAnchorElement>("[data-mail-user]")
                    .forEach((link) => {
                        const { mailUser, mailDomain } = link.dataset;
                        if (mailUser && mailDomain) {
                            link.href = `mailto:${mailUser}@${mailDomain}`;
                        }
                    });
            };

            document.addEventListener("astro:page-load", () => {
                wireMenuBurger();
                wireThemeToggle();
                assembleEmailLinks();
            });

            // After a client-side swap the <html> attribute survives but
            // the policy is re-asserted anyway (same rule as the head
            // script): stored dark choice wins, everything else is light.
            document.addEventListener("astro:after-swap", () => {
                if (localStorage.getItem("theme") === "dark") {
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.removeAttribute("data-theme");
                }
            });
        </script>
    </body>
</html>
