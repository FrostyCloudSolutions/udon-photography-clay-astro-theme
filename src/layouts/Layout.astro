---
import "../styles/vars.css";
import "../styles/content.css";
import "../styles/layout.css";

import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import { getSiteSettings, getUsedFontKeys } from "../lib/sanity";
import { BASE_FONTS_URL, FONTS, googleFontsUrl } from "../lib/fonts";

export interface Props {
    title?: string;
    description?: string;
    /** URL of the page's largest above-the-fold image (the LCP
        candidate). Tiles/cards use CSS background-image, which the
        browser only discovers after CSS parses — a preload hint with
        high priority starts the download during HTML parse instead. */
    preloadImage?: string | null;
    children?: any;
}

const { title, description, preloadImage } = Astro.props;

// Site-wide font theme (Site settings in the Studio) + on-demand
// loading of any extra fonts used via the editor's Font menu. The
// base fonts ship via vars.css; visitors download others only when
// published content actually uses them.
const settings = await getSiteSettings();
const themeFont =
    settings?.fontTheme && FONTS[settings.fontTheme] ? settings.fontTheme : "eb-garamond";
const usedFontKeys = await getUsedFontKeys();
const extraFontsUrl = googleFontsUrl([...new Set([themeFont, ...usedFontKeys])]);
const themeFontCss =
    themeFont !== "eb-garamond" ? `:root { --font-serif: ${FONTS[themeFont].stack}; }` : null;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description || "Udon Studio - Professional Photography"} />
        <meta name="viewport" content="width=device-width" />
        {/* "U" monogram in the site serif (interim logo until the
            client supplies an official one). SVG for modern browsers,
            .ico fallback, apple-touch-icon for iOS home screens. */}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title && title !== 'Udon Studio' ? `Udon Studio - ${title}` : 'Udon Studio'}</title>
        {/* Fonts load async (media=print until loaded) so text paints
            immediately in the fallback serif and upgrades — the
            render-blocking @import cost ~1.85s of first paint. The
            preconnects start both Google handshakes during HTML parse. */}
        {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={BASE_FONTS_URL} media="print" onload="this.media='all'" />
        <noscript><link rel="stylesheet" href={BASE_FONTS_URL} /></noscript>
        {extraFontsUrl && <link rel="stylesheet" href={extraFontsUrl} media="print" onload="this.media='all'" />}
        {extraFontsUrl && <noscript><link rel="stylesheet" href={extraFontsUrl} /></noscript>}
        {themeFontCss && <style set:html={themeFontCss}></style>}
        <ClientRouter />
        <script is:inline>
            // Theme init
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                return "light";
            })();
            if (theme === "dark") {
                document.documentElement.setAttribute("data-theme", "dark");
            } else {
                document.documentElement.removeAttribute("data-theme");
            }
        </script>
    </head>
    <body class="site-wrapper">
        <Header />

        <main id="site-main" class="site-main">
            <div id="swup" class="transition-fade">
                <slot />
            </div>
        </main>

        {/* Lives OUTSIDE #swup on purpose: .transition-fade keeps a
            transform (translate3d) after its entry animation, and any
            transformed ancestor becomes the containing block for
            position:fixed — the lightbox would size to the content
            column instead of the viewport (July 27 Bug 1). */}
        <Lightbox />

        <Footer />

        <script>
            import { navigate } from "astro:transitions/client";

            function initNav() {
                const burger = document.querySelector(".nav-burger");
                const wrapper = document.querySelector(".site-wrapper");
                if (burger && wrapper) {
                    burger.addEventListener("click", (e) => {
                        e.preventDefault();
                        wrapper.classList.toggle("site-head-open");
                    });
                }
            }

            function initTheme() {
                const toggleBtn = document.getElementById("theme-toggle");
                const updateIcon = () => {
                    const isDark =
                        document.documentElement.getAttribute("data-theme") ===
                        "dark";
                    // Add logic to animate or swap icons if needed, currently CSS handles visibility? No, added SVGs.
                    // Simple SVG toggle:
                    const sun = document.querySelector(
                        ".sun-icon",
                    ) as HTMLElement;
                    const moon = document.querySelector(
                        ".moon-icon",
                    ) as HTMLElement;
                    if (sun && moon) {
                        sun.style.display = isDark ? "inline-block" : "none";
                        moon.style.display = isDark ? "none" : "inline-block";
                    }
                };

                updateIcon();

                if (toggleBtn) {
                    toggleBtn.addEventListener("click", () => {
                        const currentTheme =
                            document.documentElement.getAttribute("data-theme");
                        const newTheme =
                            currentTheme === "dark" ? "light" : "dark";

                        if (newTheme === "dark") {
                            document.documentElement.setAttribute(
                                "data-theme",
                                "dark",
                            );
                        } else {
                            document.documentElement.removeAttribute(
                                "data-theme",
                            );
                        }
                        localStorage.setItem("theme", newTheme);
                        updateIcon();
                    });
                }
            }

            // Email links are shipped as split data attributes and
            // assembled here, so Cloudflare's Email Obfuscation never
            // detects/rewrites them (its decoder doesn't re-run after
            // client-side navigation, leaving broken cdn-cgi links).
            function initEmailLinks() {
                document
                    .querySelectorAll<HTMLAnchorElement>("[data-mail-user]")
                    .forEach((link) => {
                        const user = link.dataset.mailUser;
                        const domain = link.dataset.mailDomain;
                        if (user && domain) {
                            link.href = "mailto:" + user + "@" + domain;
                        }
                    });
            }

            // Run on view transitions (fires on initial load too)
            document.addEventListener("astro:page-load", () => {
                initNav();
                initTheme();
                initEmailLinks();
            });

            // Theme policy: ALWAYS light unless the visitor explicitly
            // chose dark via the toggle (stored choice); never follow the
            // OS preference. Same rule as the head init script, re-applied
            // after client-side navigation.
            document.addEventListener("astro:after-swap", () => {
                if (localStorage.getItem("theme") === "dark") {
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.removeAttribute("data-theme");
                }
            });
        </script>
    </body>
</html>
