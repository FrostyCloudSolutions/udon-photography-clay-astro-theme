---
import Layout from '../../layouts/Layout.astro';

// Post-submission landing page for the inquiry form.
---

<Layout title="Thank You">
  <article class="post-content page-template no-image">
    <div class="post-content-body">
      <section class="thanks-note">
        <h1>Thank you!</h1>
        <p>Your inquiry has been received &mdash; we&rsquo;ll be in touch soon.</p>
        <p><a href="/">BACK TO HOME</a></p>
      </section>
    </div>
  </article>
</Layout>

<style>
  .thanks-note {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>
