---
// Renders the "imageRow" portable-text block from article bodies: a
// photo grid with a chosen column count (1–4), wrapping onto new
// rows automatically (e.g. 4 photos x 2 columns = 2x2). Rows saved
// before the columns field existed carry no `columns` value and fall
// back to the old behavior (side-by-side up to 3). The small
// derivative is sized to the column count; data-full carries the
// large one for the fullscreen lightbox.
import { rowImage, largeImage, type PostPhoto } from '../lib/sanity';

interface Props {
  node: { images?: PostPhoto[]; columns?: number };
}

const { node } = Astro.props;
// Ignore entries whose upload never completed (no asset) — building
// a URL for them throws and would fail the whole site build.
const images = (node.images ?? []).filter(
  (image) => (image as { asset?: unknown }).asset,
);
const columns = Math.min(
  Math.max(node.columns ?? Math.min(images.length, 3), 1),
  4,
);
---

{images.length > 0 && (
  <div class={`image-row image-row-${columns}`}>
    {images.map((image, index) => (
      <figure class="image-row-item">
        <img
          src={rowImage(image, columns)}
          data-full={largeImage(image)}
          data-caption={image.caption ?? ''}
          alt={image.caption || `Photo ${index + 1}`}
          loading="lazy"
        />
        {image.caption && (
          <figcaption class="image-row-caption">{image.caption}</figcaption>
        )}
      </figure>
    ))}
  </div>
)}

<style>
  .image-row {
    display: grid;
    gap: 1.2rem;
    margin: 2.8rem 0;
  }
  .image-row-2 {
    grid-template-columns: 1fr 1fr;
  }
  .image-row-3 {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .image-row-4 {
    grid-template-columns: 1fr 1fr 1fr 1fr;
  }
  .image-row-item {
    margin: 0;
  }
  .image-row img {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  .image-row-caption {
    margin-top: 0.8rem;
    font-family: var(--font-sans-serif);
    font-size: 1.3rem;
    opacity: 0.6;
    text-align: center;
  }
  @media (max-width: 700px) {
    .image-row-2,
    .image-row-3 {
      grid-template-columns: 1fr;
    }
    /* 4-across keeps two columns on phones so tight mosaics still
       read as grids rather than one long strip. */
    .image-row-4 {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
