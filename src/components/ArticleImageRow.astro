---
// Renders the "imageRow" portable-text block from article bodies:
// 1, 2, or 3 photos side by side (stacked on phones). The small
// derivative is sized to the column count; data-full carries the
// large one for the fullscreen lightbox.
import { rowImage, largeImage, type PostPhoto } from '../lib/sanity';

interface Props {
  node: { images?: PostPhoto[] };
}

const { node } = Astro.props;
const images = node.images ?? [];
const columns = Math.min(Math.max(images.length, 1), 3);
---

{images.length > 0 && (
  <div class={`image-row image-row-${columns}`}>
    {images.map((image, index) => (
      <figure class="image-row-item">
        <img
          src={rowImage(image, columns)}
          data-full={largeImage(image)}
          data-caption={image.caption ?? ''}
          alt={image.caption || `Photo ${index + 1}`}
          loading="lazy"
        />
        {image.caption && (
          <figcaption class="image-row-caption">{image.caption}</figcaption>
        )}
      </figure>
    ))}
  </div>
)}

<style>
  .image-row {
    display: grid;
    gap: 1.2rem;
    margin: 2.8rem 0;
  }
  .image-row-2 {
    grid-template-columns: 1fr 1fr;
  }
  .image-row-3 {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .image-row-item {
    margin: 0;
  }
  .image-row img {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  .image-row-caption {
    margin-top: 0.8rem;
    font-family: var(--font-sans-serif);
    font-size: 1.3rem;
    opacity: 0.6;
    text-align: center;
  }
  @media (max-width: 700px) {
    .image-row-2,
    .image-row-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
