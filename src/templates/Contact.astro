---
import Layout from '../layouts/Layout.astro';
import { PortableText } from 'astro-portabletext';
import { ptComponents } from '../lib/ptComponents';
import { PORTFOLIO_CATEGORIES } from '../lib/categories';

interface Props {
  title: string;
  description?: string | null;
  image?: string | null; // pre-built CDN URL
  body?: unknown | null; // portable text blocks
}

const { title, description, image, body } = Astro.props;

// Reservation / quote-request form. Delivery goes through the
// same-origin relay at /api/contact (functions/api/contact.js) — the
// Web3Forms key lives server-side as a Cloudflare secret and never
// ships in page code. Deploys without the secret run in demo mode:
// the form works but sends nothing, and says so. (Aug 6 hardening.)
---

<Layout title={title} description={description}>
  <article class="contact-form page-template">
    <header class="post-content-header">
      <h1 class="post-content-title">{title}</h1>
    </header>

    {description && (
      <p class="post-content-excerpt">{description}</p>
    )}

    {image && (
      <div class="post-content-image">
        <img src={image} class="kg-image" alt={title} />
      </div>
    )}

    <div class="post-content-body">
      {body && (
        <div class="post-article">
          <PortableText value={body} components={ptComponents} />
        </div>
      )}

      <form id="inquiry-form" name="inquiry" method="POST" action="/api/contact">
        {/* Honeypot: visually hidden, skipped by keyboard and
            autocomplete. Humans never fill it; bots do — the relay
            answers those with a fake success and forwards nothing. */}
        <div style="display:none" aria-hidden="true">
          <label for="botcheck">Leave this field empty</label>
          <input type="text" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
        </div>

        <div class="row gtr-uniform">
          <div class="col-6 col-12-xsmall">
            <input type="text" name="name" id="name" placeholder="Full Name" required />
          </div>
          <div class="col-6 col-12-xsmall">
            <input type="email" name="email" id="email" placeholder="Email" required />
          </div>

          {/* Six-row layout (July 27 update, Task 5): every pair of
              col-6 fields forms one visual row, and every CONDITIONAL
              field is either full-width (col-12) or replaces a whole
              row — so showing/hiding one never re-pairs the fields
              below it (that grid shift was Bug 2). */}
          <div class="col-6 col-12-xsmall">
            <input type="tel" name="phone" id="phone" placeholder="Phone (optional)" />
          </div>
          <div class="col-6 col-12-xsmall">
            <select name="heard-about" id="heard-about" required>
              <option value="">How did you hear about us?</option>
              <option value="Instagram">Instagram</option>
              <option value="Xiaohongshu">小红书 (RedNote / Xiaohongshu)</option>
              <option value="YouTube">YouTube</option>
              <option value="TikTok">TikTok</option>
              <option value="Facebook">Facebook</option>
              <option value="WeChat">WeChat</option>
              <option value="Google search">Google search</option>
              <option value="Friend or family">Friend or family</option>
              <option value="Past client">I'm a past client</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="col-12 heard-other-only" hidden>
            <input type="text" name="heard-about-other" id="heard-about-other" placeholder="Tell us how you found us" required disabled />
          </div>

          {/* City dropdown + free-text suburb, grouped on one row:
              suburb names repeat between Sydney and Melbourne, so the
              city is captured structurally instead of via the text. */}
          <div class="col-6 col-12-xsmall">
            <select name="city" id="city" required>
              <option value="">Which city?</option>
              <option value="Sydney">Sydney</option>
              <option value="Melbourne">Melbourne</option>
              <option value="Somewhere else">Somewhere else</option>
            </select>
          </div>
          <div class="col-6 col-12-xsmall">
            <input type="text" name="location" id="location" placeholder="Suburb or neighbourhood — please be specific" required />
          </div>

          {/* Dates sit ABOVE the category row (July 29 revision) so
              the category's follow-up questions — weeks pregnant,
              baby age, wedding details — appear directly below the
              category picker that triggered them. */}
          <div class="col-6 col-12-xsmall date-range-only">
            <label for="date-from">Preferred dates &mdash; from</label>
            <input type="date" name="preferred-date-from" id="date-from" required />
          </div>
          <div class="col-6 col-12-xsmall date-range-only">
            <label for="date-to">Preferred dates &mdash; to</label>
            <input type="date" name="preferred-date-to" id="date-to" />
          </div>

          <div class="col-6 col-12-xsmall">
            <select name="session-type" id="session-type" required>
              <option value="">Session Type</option>
              {PORTFOLIO_CATEGORIES.map((category) => (
                <option value={category}>{category}</option>
              ))}
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="col-6 col-12-xsmall">
            <select name="group-size" id="group-size" required>
              <option value="">How many people?</option>
              <option value="1-2 people">1&ndash;2 people</option>
              <option value="3-4 people">3&ndash;4 people</option>
              <option value="5-6 people">5&ndash;6 people</option>
              <option value="7+ people">7+ people</option>
            </select>
          </div>

          <div class="col-12 maternity-only" hidden>
            <input type="number" name="weeks-pregnant" id="weeks-pregnant" min="1" max="45" placeholder="How many weeks pregnant are you currently? (optional)" disabled />
          </div>

          <div class="col-12 baby-only" hidden>
            <input type="number" name="baby-age-months" id="baby-age-months" min="0" max="36" placeholder="How old is your baby, in months? (optional)" disabled />
          </div>

          <div class="col-6 col-12-xsmall wedding-only" hidden>
            <label for="wedding-date">Wedding date</label>
            <input type="date" name="wedding-date" id="wedding-date" required disabled />
          </div>
          <div class="col-6 col-12-xsmall wedding-only" hidden>
            <label for="wedding-time">Start time (optional)</label>
            <input type="time" name="wedding-time" id="wedding-time" disabled />
          </div>
          <div class="col-12 wedding-only" hidden>
            <input type="text" name="wedding-venue" id="wedding-venue" placeholder="Venue / ceremony location" required disabled />
          </div>

          <div class="col-12">
            <textarea name="message" id="message" placeholder="Tell us about what you're looking for" rows="6" required></textarea>
          </div>

          <div class="col-12">
            <p>
              Before booking, I do hope you&rsquo;ve had a chance to explore my portfolio and
              photography style, as finding the right photographer is a two-way connection.
              It helps ensure that we&rsquo;re a good fit and can create something meaningful together.
            </p>
            <p>
              I look forward to hearing from you!<br />
              Udon Studio
            </p>
          </div>

          <div class="col-12" id="inquiry-form-status" role="status"></div>

          <div class="col-12">
            <ul class="actions special">
              <li>
                <input type="submit" value="Send Inquiry" class="primary" />
              </li>
            </ul>
          </div>
        </div>
      </form>
    </div>
  </article>
</Layout>

<script>
  function initInquiryForm() {
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    if (!form || form.dataset.enhanced === '1') return;
    form.dataset.enhanced = '1';

    const status = document.getElementById('inquiry-form-status');
    const sessionType = form.querySelector('#session-type') as HTMLSelectElement | null;

    // Hidden conditional fields are also disabled so they neither block
    // native validation nor submit stale values.
    const toggleGroup = (selector: string, show: boolean) => {
      form.querySelectorAll<HTMLElement>(selector).forEach((wrapper) => {
        wrapper.hidden = !show;
        wrapper.querySelectorAll<HTMLInputElement>('input, select').forEach((field) => {
          field.disabled = !show;
        });
      });
    };

    const updateConditionalFields = () => {
      const type = sessionType?.value;
      toggleGroup('.maternity-only', type === 'Maternity');
      toggleGroup('.baby-only', type === 'Babies');
      toggleGroup('.wedding-only', type === 'Weddings');
      toggleGroup('.date-range-only', type !== 'Weddings');
    };
    sessionType?.addEventListener('change', updateConditionalFields);
    updateConditionalFields();

    // "How did you hear about us?" — the free-text box appears only
    // when "Other" is chosen (same hidden+disabled pattern as the
    // session-type conditionals).
    const heardAbout = form.querySelector('#heard-about') as HTMLSelectElement | null;
    const updateHeardAbout = () => {
      toggleGroup('.heard-other-only', heardAbout?.value === 'Other');
    };
    heardAbout?.addEventListener('change', updateHeardAbout);
    updateHeardAbout();

    const dateFrom = form.querySelector('#date-from') as HTMLInputElement | null;
    const dateTo = form.querySelector('#date-to') as HTMLInputElement | null;
    dateFrom?.addEventListener('change', () => {
      if (!dateTo || !dateFrom.value) return;
      dateTo.min = dateFrom.value;
      if (dateTo.value && dateTo.value < dateFrom.value) dateTo.value = dateFrom.value;
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitBtn = form.querySelector('input[type="submit"]') as HTMLInputElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.value = 'Sending...';
      }
      if (status) status.textContent = '';

      try {
        // FormData -> plain JSON for the relay. Disabled (hidden
        // conditional) fields are excluded automatically; the relay
        // builds the subject and replyto server-side.
        const payload: Record<string, string> = {};
        new FormData(form).forEach((value, key) => {
          payload[key] = value.toString();
        });

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (result.success && result.demo) {
          // No delivery key configured on this deployment (previews,
          // demos): be honest instead of pretending it sent.
          if (status) status.textContent = '(Demo form — no message was actually sent.)';
          const submitBtn2 = form.querySelector('input[type="submit"]') as HTMLInputElement | null;
          if (submitBtn2) {
            submitBtn2.disabled = false;
            submitBtn2.value = 'Send Inquiry';
          }
        } else if (result.success) {
          window.location.assign('/inquire/thanks/');
        } else {
          throw new Error(result.error || 'Submission failed');
        }
      } catch {
        if (status) status.textContent = 'Something went wrong sending your inquiry. Please try again or email us directly.';
        const submitBtn = form.querySelector('input[type="submit"]') as HTMLInputElement | null;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.value = 'Send Inquiry';
        }
      }
    });
  }

  initInquiryForm();
  document.addEventListener('astro:page-load', initInquiryForm);
</script>
